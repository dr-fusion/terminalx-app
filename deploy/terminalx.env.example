# TerminalX production environment (systemd EnvironmentFile).
# Install to /etc/terminalx/terminalx.env with mode 0600, owned by the service user.
# NEVER commit real secret values. Prefer *_FILE indirection where supported.

# --- Core ---
PORT=3000
TERMINUS_HOST=127.0.0.1
TERMINUS_ROOT=/opt/terminalx/workspace
NODE_ENV=production

# --- Auth (see README) ---
TERMINALX_AUTH_MODE=local
# TERMINALX_JWT_SECRET is required (>= 32 chars). Provide via a file the service
# user can read, or inline here (this file must be 0600).
# TERMINALX_JWT_SECRET=
# TERMINALX_ADMIN_USERNAME=admin
# TERMINALX_ADMIN_PASSWORD=   # only needed on first startup

# --- Behind a reverse proxy ---
# TERMINALX_PUBLIC_URL=https://terminalx.example.com
# TERMINALX_TRUST_PROXY=1

# --- Operations (Phase 11C) ---
# Metrics scrape token; a Prometheus scraper presents it as a bearer token.
# Leave unset to require an authenticated admin session instead.
# TERMINALX_METRICS_TOKEN=
# Structured telemetry level: debug | info | warn | error (default info).
# TERMINALX_LOG_LEVEL=info
# Backups (defaults live under data/backups). Retention counts.
# TERMINALX_BACKUP_DIR=/opt/terminalx/data/backups/full
# TERMINALX_BACKUP_KEEP=14
# TERMINALX_PRE_MIGRATION_SNAPSHOT_KEEP=10

# --- Secret Broker (optional; supervised as a sibling service) ---
# TERMINALX_SECRET_BROKER_ROOT=/run/terminalx-secret-broker
